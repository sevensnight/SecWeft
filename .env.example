# Development bootstrap credential. Replace before starting the service.
VULNLAB_ADMIN_KEY=replace-with-a-long-random-admin-key
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VULNLAB_MASTER_KEY=replace-with-a-fernet-key
VULNLAB_ENV=development
VULNLAB_DB_PATH=/data/vulnlab.db
VULNLAB_WORKSPACE_ROOT=/data/workspaces
VULNLAB_EXECUTION_MODE=dry_run
VULNLAB_LEGACY_EXECUTION_ENABLED=false
VULNLAB_DOCKER_IMAGE=python:3.12-alpine
VULNLAB_ALLOWED_HOSTS=localhost,127.0.0.1,::1,target-vulnerable,target-patched
VULNLAB_ALLOWED_PORTS=80,443,8000,8080
VULNLAB_ALLOW_PRIVATE_NETWORKS=false

# P1 enterprise mode. Compatibility remains suitable only for local migration work.
VULNLAB_AUTH_MODE=compatibility
DATABASE_URL=postgresql://vulnlab_app:replace-me@127.0.0.1:5432/vulnlab
VULNLAB_OIDC_ISSUER=http://127.0.0.1:8081/realms/vulnlab-development
# Browser-visible OIDC origin allowed by the gateway Content Security Policy.
# Production deployments must set this to the HTTPS origin of their identity provider.
VULNLAB_OIDC_BROWSER_ORIGIN=http://127.0.0.1:8081
VULNLAB_OIDC_AUDIENCE=vulnlab-control-plane
VULNLAB_OIDC_JWKS_URL=http://127.0.0.1:8081/realms/vulnlab-development/protocol/openid-connect/certs
VULNLAB_OIDC_TENANT_CLAIM=tenant_id
# Optional exact ACR value required by the API and requested by the browser (for example an MFA policy URI).
VULNLAB_OIDC_REQUIRED_ACR=
VULNLAB_OIDC_LEEWAY_SECONDS=30
VULNLAB_DATABASE_POOL_MIN_SIZE=1
VULNLAB_DATABASE_POOL_MAX_SIZE=8
VULNLAB_DATABASE_POOL_TIMEOUT_SECONDS=10
