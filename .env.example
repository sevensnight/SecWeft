# Development bootstrap credential. Replace before starting the service.
VULNLAB_ADMIN_KEY=replace-with-a-long-random-admin-key
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VULNLAB_MASTER_KEY=replace-with-a-fernet-key
VULNLAB_ENV=development
VULNLAB_DB_PATH=/data/vulnlab.db
VULNLAB_WORKSPACE_ROOT=/data/workspaces
VULNLAB_EXECUTION_MODE=dry_run
VULNLAB_LEGACY_EXECUTION_ENABLED=false
VULNLAB_DOCKER_IMAGE=python:3.12-alpine
VULNLAB_ALLOWED_HOSTS=localhost,127.0.0.1,::1,target-vulnerable,target-patched
VULNLAB_ALLOWED_PORTS=80,443,8000,8080
VULNLAB_ALLOW_PRIVATE_NETWORKS=false
