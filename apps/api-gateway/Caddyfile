{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; worker-src 'self' blob:"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
	}

	handle /gateway-healthz {
		respond "ok" 200
	}

	@backend path /api/* /health /ready /docs* /redoc* /openapi.json
	handle @backend {
		reverse_proxy api:8000 {
			health_uri /health
			health_interval 15s
			health_timeout 3s
		}
	}

	handle {
		reverse_proxy web-console:8080 {
			health_uri /healthz
			health_interval 15s
			health_timeout 3s
		}
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>X-Api-Key delete
			}
		}
	}
}
