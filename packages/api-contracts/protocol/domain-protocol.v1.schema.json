{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.vulnlab.local/protocol/domain-protocol.v1.schema.json",
  "title": "VulnLab Domain Protocol V1",
  "oneOf": [
    { "$ref": "#/$defs/tool" },
    { "$ref": "#/$defs/skill" },
    { "$ref": "#/$defs/agent" },
    { "$ref": "#/$defs/workflow" },
    { "$ref": "#/$defs/policyDecision" },
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/evidence" }
  ],
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "tenant_id", "project_id"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "tenant_id": { "type": "string", "format": "uuid" },
        "project_id": { "type": ["string", "null"], "format": "uuid" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "metadata", "input_schema", "output_schema", "risk_level", "permissions"],
      "properties": {
        "kind": { "const": "ToolDefinition" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "input_schema": { "type": "object" },
        "output_schema": { "type": "object" },
        "risk_level": { "enum": ["R0", "R1", "R2", "R3", "R4"] },
        "permissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "metadata", "tools", "input_schema", "output_schema", "approval_required"],
      "properties": {
        "kind": { "const": "SkillDefinition" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "input_schema": { "type": "object" },
        "output_schema": { "type": "object" },
        "approval_required": { "type": "boolean" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "metadata", "responsibility", "skills", "token_budget", "timeout_seconds"],
      "properties": {
        "kind": { "const": "AgentDefinition" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "responsibility": { "type": "string", "minLength": 1 },
        "skills": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "token_budget": { "type": "integer", "minimum": 1 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "metadata", "nodes", "edges"],
      "properties": {
        "kind": { "const": "WorkflowDefinition" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "nodes": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "edges": { "type": "array", "items": { "type": "object" } }
      }
    },
    "policyDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "decision_id", "decision", "matched_policy_ids", "obligations"],
      "properties": {
        "kind": { "const": "PolicyDecision" },
        "decision_id": { "type": "string", "format": "uuid" },
        "decision": { "enum": ["ALLOW", "DENY", "REQUIRE_APPROVAL"] },
        "matched_policy_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } },
        "obligations": { "type": "array", "items": { "type": "object" } },
        "reason_code": { "type": ["string", "null"] }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "started_at", "finished_at", "summary"],
      "properties": {
        "kind": { "const": "ResultDefinition" },
        "status": { "enum": ["SUCCEEDED", "FAILED", "CANCELLED", "TIMED_OUT"] },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "summary": { "type": "string" },
        "error_code": { "type": ["string", "null"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "evidence_id", "sha256", "source", "collected_at", "artifact_uri"],
      "properties": {
        "kind": { "const": "EvidenceDefinition" },
        "evidence_id": { "type": "string", "format": "uuid" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source": { "type": "string" },
        "collected_at": { "type": "string", "format": "date-time" },
        "artifact_uri": { "type": "string", "format": "uri" },
        "classification": { "enum": ["PUBLIC", "INTERNAL", "RESTRICTED"] }
      }
    }
  }
}
