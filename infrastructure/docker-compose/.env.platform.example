# Copy this file to .env.platform and replace every GENERATE_* value.
# The start scripts reject placeholders and short secrets.
VULNLAB_ENV=development
VULNLAB_ADMIN_KEY=GENERATE_AT_LEAST_24_RANDOM_CHARACTERS
VULNLAB_MASTER_KEY=GENERATE_A_VALID_FERNET_KEY
VULNLAB_EXECUTION_MODE=dry_run
VULNLAB_LEGACY_EXECUTION_ENABLED=false
VULNLAB_ALLOWED_HOSTS=localhost,127.0.0.1,::1
VULNLAB_ALLOWED_PORTS=80,443,8000,8080

PLATFORM_POSTGRES_USER=vulnlab
PLATFORM_POSTGRES_PASSWORD=GENERATE_URL_SAFE_POSTGRES_PASSWORD
PLATFORM_POSTGRES_APP_PASSWORD=GENERATE_SEPARATE_URL_SAFE_APPLICATION_PASSWORD
PLATFORM_POSTGRES_DB=vulnlab
PLATFORM_REDIS_PASSWORD=GENERATE_URL_SAFE_REDIS_PASSWORD
PLATFORM_NATS_USER=vulnlab
PLATFORM_NATS_PASSWORD=GENERATE_URL_SAFE_NATS_PASSWORD
PLATFORM_MINIO_ROOT_USER=vulnlabadmin
PLATFORM_MINIO_ROOT_PASSWORD=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS

# Optional development OIDC provider (`--profile identity`). Its container
# refuses to start while either value still has the GENERATE_ prefix.
PLATFORM_KEYCLOAK_ADMIN_USER=vulnlab-admin
PLATFORM_KEYCLOAK_ADMIN_PASSWORD=GENERATE_AT_LEAST_24_RANDOM_CHARACTERS
PLATFORM_KEYCLOAK_PORT=8081

# Set VULNLAB_AUTH_MODE=oidc together with the identity profile for P1.
VULNLAB_AUTH_MODE=compatibility
VULNLAB_OIDC_ISSUER=http://127.0.0.1:8081/realms/vulnlab-development
# Browser-visible identity-provider origin used by the gateway CSP.
VULNLAB_OIDC_BROWSER_ORIGIN=http://127.0.0.1:8081
VULNLAB_OIDC_AUDIENCE=vulnlab-control-plane
VULNLAB_OIDC_JWKS_URL=http://keycloak:8080/realms/vulnlab-development/protocol/openid-connect/certs
VULNLAB_OIDC_TENANT_CLAIM=tenant_id
# Optional exact organization-defined ACR value used to enforce MFA/authentication strength.
VULNLAB_OIDC_REQUIRED_ACR=

PLATFORM_BIND_ADDRESS=127.0.0.1
PLATFORM_GATEWAY_PORT=8080
PLATFORM_MINIO_CONSOLE_PORT=9001
PLATFORM_PROMETHEUS_PORT=9090
PLATFORM_METRICS_RETENTION=15d
