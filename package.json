{
  "name": "vulnlab-module2-monorepo",
  "version": "2.14.0-p14",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.17.0",
    "pnpm": ">=10.30.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "generate:api": "pnpm --filter @vulnlab/shared-types generate",
    "check:bundle": "pnpm --filter @vulnlab/web-console check:bundle"
  },
  "devDependencies": {
    "turbo": "2.10.4"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.11"
    }
  }
}
